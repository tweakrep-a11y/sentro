<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="126dp"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/home_v3_item_ripple"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/homeV3RankImage"
            android:layout_width="98dp"
            android:layout_height="140dp"
                android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.HomeV3Rank" />

        <miku.moe.app.HomeV3TimelineView
            android:id="@+id/homeV3RankTimeline"
            android:layout_width="28dp"
            android:layout_height="140dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/homeV3RankTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="6dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:minLines="2"
        android:textColor="?attr/colorOnSurface"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/homeV3RankTypeChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/home_v3_genre_chip_bg"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingTop="7dp"
        android:paddingEnd="12dp"
        android:paddingBottom="7dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="12sp"
        android:visibility="invisible" />
</LinearLayout>
